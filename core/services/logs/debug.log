[2026-01-22 14:38:19] RAW SELECT executado {
    "sql": "SELECT alocacoes.tarefa_id, alocacoes.recurso_id, tarefas.projeto_id, tarefas.descricao FROM alocacoes LEFT JOIN tarefas \r\n                           ON alocacoes.tarefa_id = tarefas.id LEFT JOIN recursos \r\n                           ON alocacoes.recurso_id = recursos.id LEFT JOIN pessoas \r\n                           ON alocacoes.aprovado_por = pessoas.id LIMIT 50"
